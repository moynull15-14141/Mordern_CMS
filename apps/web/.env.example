# apps/web — required environment variables. No secrets here; safe to
# commit. Copy to .env.local (gitignored) and fill in real values per
# environment. Read/validated by src/lib/env.ts (fails fast on boot if
# either is missing or not a valid URL).

# The backend API's base URL (server-side only — every fetch this app
# makes happens in Server Components, never the browser).
API_BASE_URL=http://localhost:4000/api/v1

# This site's own public base URL, no trailing slash. Used to build
# absolute URLs in sitemap.xml/robots.txt and as a canonical-URL fallback.
# Set this to the real production domain when deploying — never leave it
# pointing at localhost outside local development.
SITE_URL=http://localhost:3002
